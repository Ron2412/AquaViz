# AquaViz backend configuration — copy to `.env` and edit for your machine.
# `.env` is gitignored; this example is committed. No secrets belong here.

# --- Data locations --------------------------------------------------------

# Directory the app scans for compact NetCDF grids and Argo *_prof.nc files.
# Defaults to backend/data (gitignored). Small files can live here directly.
# AQUAVIZ_DATA_DIR=backend/data

# Large ocean-MODEL file (e.g. the ~10 GB HYCOM NetCDF). DO NOT commit it and
# DO NOT copy it into the repo — point this at wherever it actually lives.
# When unset, the model source auto-discovers *hycom*.nc inside AQUAVIZ_DATA_DIR.
# MODEL_DATA_PATH=/absolute/path/to/RSMC_hycom_YYYYMMDD.nc

# Argo OBSERVATION file (the *_prof.nc floats). When unset, the Argo source
# auto-discovers the first *_prof.nc inside AQUAVIZ_DATA_DIR.
# ARGO_DATA_PATH=backend/data/2022_01_20220101_prof.nc

# --- API -------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API (CORS).
# AQUAVIZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
